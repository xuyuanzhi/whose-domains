[Unit]
Description=Whose.Domains administration application
Wants=network-online.target redis-server.service
After=network-online.target redis-server.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=wesite
Group=wesite
WorkingDirectory=/usr/java/apps/admin/current
EnvironmentFile=/etc/wesite/wesite.env
ExecStartPre=/usr/bin/test -r /usr/java/apps/admin/current/wesite-admin.jar
ExecStartPre=/usr/bin/test -r /usr/java/config/admin/application-prod.properties
ExecStart=/usr/bin/java -Xms128m -Xmx384m -Xss512k -XX:MaxMetaspaceSize=160m -XX:MaxDirectMemorySize=64m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -jar /usr/java/apps/admin/current/wesite-admin.jar --spring.profiles.active=prod --spring.config.additional-location=file:/usr/java/config/admin/ --server.address=127.0.0.1 --server.port=8082
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=45
KillSignal=SIGTERM
SuccessExitStatus=143
LimitNOFILE=32768
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/usr/java/logs /var/www/sitemap
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wesite-admin

[Install]
WantedBy=multi-user.target
