# Copy to /etc/wesite/wesite.env, keep mode 0600, and replace every CHANGE_ME value.
# This file uses systemd EnvironmentFile syntax, not shell syntax: do not add "export".

WD_DB_URL=CHANGE_ME_TO_THE_EXISTING_TESTED_JDBC_URL
WD_DB_USERNAME=CHANGE_ME
WD_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME_OR_LEAVE_EMPTY

JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
BLOG_INTERNAL_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
WESITE_PUBLIC_BASE_URL=https://whose.domains
WESITE_AUTH_COOKIE_SECURE=true
WESITE_SUPPORT_URL=https://www.paypal.com/ncp/payment/LFWN7F5X9626W

WESITE_GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEEPSEEK_API_KEY=

RESEND_API_KEY=
WESITE_MAIL_FROM=alerts@mail.whose.domains
WESITE_MAIL_REPLY_TO=support@whose.domains
WESITE_NOTIFICATION_DELIVERY_IMMEDIATE_ENABLED=false
WESITE_NOTIFICATION_DELIVERY_DIGEST_ENABLED=false
WESITE_RETENTION_REPORTING_ZONE=Asia/Shanghai
